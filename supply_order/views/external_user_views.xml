<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="external_user_view_list" model="ir.ui.view">
        <field name="name">external.user.list</field>
        <field name="model">external.user</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="login"/>
                <field name="role"/>
                <field name="external_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="external_user_action" model="ir.actions.act_window">
        <field name="name">App Users</field>
        <field name="res_model">external.user</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
