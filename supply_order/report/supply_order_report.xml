<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_supply_quotation" model="ir.actions.report">
        <field name="name">Quotation</field>
        <field name="model">supply.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">supply_order.report_supply_quotation</field>
        <field name="print_report_name">'Quotation - %s' % (object.supply_ref or object.name)</field>
        <field name="binding_model_id" ref="model_supply_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_supply_quotation_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="address">
            <div t-field="doc.partner_id" class="mb-0"
                 t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
            <p t-if="doc.partner_id.vat" class="mb-0">Tax ID: <span t-field="doc.partner_id.vat"/></p>
        </t>
        <t t-set="layout_document_title">
            <span>Quotation # </span><span t-field="doc.name"/>
        </t>
        <t t-call="web.external_layout" address="address" layout_document_title="layout_document_title">
            <div class="page">
                <div class="oe_structure"/>
                <div id="informations" class="row mb-4">
                    <div class="col-auto" style="padding-right: 40px;" t-if="doc.supply_ref">
                        <strong>Supply Order No.:</strong>
                        <div t-field="doc.supply_ref"/>
                    </div>
                    <div class="col-auto">
                        <strong>Date:</strong>
                        <div t-field="doc.date_order" t-options='{"widget": "date"}'/>
                    </div>
                </div>
                <t t-set="lines" t-value="doc.line_ids.filtered(lambda l: l.qty_requested).sorted('line_no')"/>
                <t t-set="show_discount" t-value="any(lines.mapped('discount'))"/>
                <t t-set="show_taxes" t-value="any(lines.mapped('tax_ids'))"/>
                <table class="o_has_total_table table o_main_table table-borderless">
                    <thead style="display: table-row-group">
                        <tr>
                            <th class="text-start">#</th>
                            <th class="text-start">Description</th>
                            <th class="text-end text-nowrap">Quantity</th>
                            <th class="text-end text-nowrap">Unit Price</th>
                            <th t-if="show_discount" class="text-end">Disc.%</th>
                            <th t-if="show_taxes" class="text-end">Taxes</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines" t-as="line">
                            <tr>
                                <td class="text-start"><span t-field="line.line_no"/></td>
                                <td class="text-start">
                                    <span t-field="line.product_id.display_name"/>
                                    <div t-if="line.line_note" class="text-muted small"><span t-field="line.line_note"/></div>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-field="line.qty_requested"/>
                                    <span t-field="line.uom_id"/>
                                </td>
                                <td class="text-end text-nowrap"><span t-field="line.price_unit"/></td>
                                <td t-if="show_discount" class="text-end"><span t-field="line.discount"/></td>
                                <td t-if="show_taxes" class="text-end">
                                    <span t-out="', '.join(line.tax_ids.mapped('name'))"/>
                                </td>
                                <td class="text-end text-nowrap"><span t-field="line.price_subtotal"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <div class="clearfix">
                    <div class="row justify-content-end">
                        <div class="col-5">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td><strong>Untaxed Amount</strong></td>
                                    <td class="text-end"><span t-field="doc.amount_untaxed"/></td>
                                </tr>
                                <tr t-if="doc.amount_tax">
                                    <td>Taxes</td>
                                    <td class="text-end"><span t-field="doc.amount_tax"/></td>
                                </tr>
                                <tr class="border-top">
                                    <td><strong>Total</strong></td>
                                    <td class="text-end"><strong t-field="doc.amount_total"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div t-if="doc.note" class="mt-3"><span t-field="doc.note"/></div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_supply_quotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="supply_order.report_supply_quotation_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
