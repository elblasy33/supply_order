<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_supply" model="res.groups.privilege">
        <field name="name">Supply Orders</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>
    <record id="group_supply_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_supply"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_supply_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_supply"/>
        <field name="implied_ids" eval="[(4, ref('group_supply_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
