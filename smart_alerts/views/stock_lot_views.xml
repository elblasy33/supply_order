<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_lot_expiry_alert_view_list" model="ir.ui.view">
        <field name="name">stock.lot.expiry.alert.list</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="expiry_state == 'expired'" decoration-warning="expiry_state == 'alert'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="product_qty" string="On hand"/>
                <field name="expiration_date"/>
                <field name="alert_date" optional="show"/>
                <field name="days_to_expiry"/>
                <field name="expiry_state" widget="badge"
                       decoration-danger="expiry_state == 'expired'" decoration-warning="expiry_state == 'alert'"
                       decoration-success="expiry_state == 'ok'"/>
            </list>
        </field>
    </record>

    <record id="stock_lot_expiry_alert_view_search" model="ir.ui.view">
        <field name="name">stock.lot.expiry.alert.search</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <filter name="alert" string="Alert reached" domain="[('expiry_state', '=', 'alert')]"/>
                <filter name="expired" string="Expired" domain="[('expiry_state', '=', 'expired')]"/>
                <separator/>
                <filter name="in_7" string="Expires within 7 days"
                        domain="[('expiration_date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="in_30" string="Expires within 30 days"
                        domain="[('expiration_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="in_60" string="Expires within 60 days"
                        domain="[('expiration_date', '&lt;=', (context_today() + relativedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'expiry_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="stock_lot_expiry_alert_action" model="ir.actions.act_window">
        <field name="name">Expiry Alerts</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('product_qty', '&gt;', 0), ('expiration_date', '!=', False)]</field>
        <field name="search_view_id" ref="stock_lot_expiry_alert_view_search"/>
        <field name="context">{'search_default_in_30': 1, 'search_default_group_product': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('stock_lot_expiry_alert_view_list')}), (0, 0, {'view_mode': 'form'})]"/>
    </record>
</odoo>
