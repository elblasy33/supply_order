<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_rebates" model="ir.ui.view">
        <field name="name">res.company.form.rebates</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Discounts &amp; Rebates" name="rebates" groups="account.group_account_manager">
                    <div class="alert alert-info" role="alert">
                        A rebate owed to a customer is provisioned (expense / accrued payable); the customer credit note is
                        then posted against the accrued account, so revenue is not reduced twice. Vendor rebates mirror it
                        (accrued receivable / rebate income). The button creates a <b>proposal</b> to review with the accountant.
                    </div>
                    <group>
                        <group string="Customers">
                            <field name="rebate_expense_account_id"/>
                            <field name="rebate_accrual_sale_account_id"/>
                        </group>
                        <group string="Vendors">
                            <field name="rebate_income_account_id"/>
                            <field name="rebate_accrual_purchase_account_id"/>
                        </group>
                        <group string="Journal">
                            <field name="rebate_journal_id"/>
                        </group>
                    </group>
                    <button name="action_create_suggested_rebate_accounts" type="object"
                            string="Create the suggested accounts and journal" class="btn-secondary"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
