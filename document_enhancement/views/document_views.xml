<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_line_no" model="ir.ui.view">
        <field name="name">sale.order.form.line.no</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='sequence']" position="after">
                <field name="line_no" optional="show" width="50px"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="line_note" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_line_no" model="ir.ui.view">
        <field name="name">purchase.order.form.line.no</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='sequence']" position="after">
                <field name="line_no" optional="show" width="50px"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="line_note" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_line_no" model="ir.ui.view">
        <field name="name">stock.picking.form.line.no</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='sequence']" position="after">
                <field name="line_no" optional="show" width="50px"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list" position="inside">
                <field name="line_note" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_line_no" model="ir.ui.view">
        <field name="name">account.move.form.line.no</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='sequence']" position="after">
                <field name="line_no" optional="show" width="50px"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list" position="inside">
                <field name="line_note" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
