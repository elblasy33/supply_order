<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="smart_reconcile_wizard_view_form" model="ir.ui.view">
        <field name="name">smart.reconcile.wizard.form</field>
        <field name="model">smart.reconcile.wizard</field>
        <field name="arch" type="xml">
            <form string="Reconcile Invoices">
                <field name="state" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group invisible="state == 'done'">
                    <group>
                        <field name="kind" readonly="state != 'draft'"/>
                        <field name="partner_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                    </group>
                    <group>
                        <field name="date_from" readonly="state != 'draft'"/>
                        <field name="date_to" readonly="state != 'draft'"/>
                        <field name="allocation_order" readonly="state == 'done'"/>
                    </group>
                </group>
                <div invisible="state != 'draft'" class="text-muted">
                    Choose the customer or vendor and the period, then load their open invoices and payments.
                </div>
                <group invisible="state != 'loaded'">
                    <group string="Invoices to reconcile (tick the ones you want)">
                        <field name="invoice_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom" create="0" delete="0">
                                <field name="selected"/>
                                <field name="move_id" readonly="1"/>
                                <field name="date" readonly="1"/>
                                <field name="date_maturity" readonly="1"/>
                                <field name="residual" readonly="1" sum="Selected"/>
                                <field name="doc_currency_id" optional="show" readonly="1"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                    </group>
                    <group string="Payments and credit notes available">
                        <field name="payment_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom" create="0" delete="0">
                                <field name="selected"/>
                                <field name="move_id" readonly="1"/>
                                <field name="date" readonly="1"/>
                                <field name="residual" readonly="1" sum="Available"/>
                                <field name="doc_currency_id" optional="show" readonly="1"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                    </group>
                </group>
                <group invisible="state != 'loaded'" class="oe_subtotal_footer">
                    <field name="selected_total"/>
                    <field name="available_total"/>
                    <field name="remaining_total"/>
                </group>
                <group invisible="state != 'done'" string="Result">
                    <field name="log_ids" nolabel="1" colspan="2">
                        <list create="0" delete="0" edit="0">
                            <field name="invoice_id"/>
                            <field name="payment_move_id"/>
                            <field name="amount" sum="Reconciled"/>
                            <field name="invoice_residual_after"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <field name="remaining_total" string="Still due on the selected invoices"/>
                </group>
                <footer>
                    <button name="action_load" string="Load open items" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_load" string="Reload" type="object" invisible="state != 'loaded'"/>
                    <button name="action_reconcile" string="Reconcile" type="object" class="btn-primary"
                            invisible="state != 'loaded'"/>
                    <button string="Close" special="cancel" invisible="state == 'draft'"/>
                    <button string="Cancel" special="cancel" invisible="state != 'draft'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="smart_reconcile_wizard_action" model="ir.actions.act_window">
        <field name="name">Reconcile Invoices</field>
        <field name="res_model">smart.reconcile.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="smart_reconcile_log_view_list" model="ir.ui.view">
        <field name="name">smart.reconcile.log.list</field>
        <field name="model">smart.reconcile.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="batch"/>
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="kind"/>
                <field name="invoice_id"/>
                <field name="payment_move_id"/>
                <field name="amount" sum="Reconciled"/>
                <field name="invoice_residual_after"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="smart_reconcile_log_view_search" model="ir.ui.view">
        <field name="name">smart.reconcile.log.search</field>
        <field name="model">smart.reconcile.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <field name="payment_move_id"/>
                <field name="batch"/>
                <filter name="customers" string="Customers" domain="[('kind', '=', 'customer')]"/>
                <filter name="vendors" string="Vendors" domain="[('kind', '=', 'vendor')]"/>
                <group>
                    <filter name="group_batch" string="Run" context="{'group_by': 'batch'}"/>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="smart_reconcile_log_action" model="ir.actions.act_window">
        <field name="name">Reconciliation Log</field>
        <field name="res_model">smart.reconcile.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_smart_reconcile_root" name="Reconciliation" parent="account.menu_finance_entries"
              sequence="40" groups="account.group_account_invoice"/>
    <menuitem id="menu_smart_reconcile_wizard" name="Reconcile Invoices" parent="menu_smart_reconcile_root"
              action="smart_reconcile_wizard_action" sequence="10"/>
    <menuitem id="menu_smart_reconcile_log" name="Reconciliation Log" parent="menu_smart_reconcile_root"
              action="smart_reconcile_log_action" sequence="20"/>
</odoo>
