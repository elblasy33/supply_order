<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_lot_auto" model="ir.ui.view">
        <field name="name">product.template.form.lot.auto</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_form_view_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='traceability']" position="inside">
                <field name="lot_auto_generate" invisible="store_by != 'lot'"/>
                <field name="lot_pattern" invisible="store_by != 'lot' or not lot_auto_generate"
                       required="lot_auto_generate" placeholder="{code}-{date}-{seq}"/>
            </xpath>
        </field>
    </record>
</odoo>
