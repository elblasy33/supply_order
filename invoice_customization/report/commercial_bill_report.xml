<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_commercial_bill" model="ir.actions.report">
        <field name="name">Commercial Bill</field>
        <field name="model">supply.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_customization.report_commercial_bill</field>
        <field name="print_report_name">'Commercial Bill - %s' % (object.supply_ref or object.name)</field>
        <field name="binding_model_id" ref="supply_order.model_supply_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_commercial_bill_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="address">
            <strong>Consignee</strong>
            <div t-field="doc.partner_id" class="mb-0"
                 t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
        </t>
        <t t-set="layout_document_title">
            <span t-out="company.commercial_bill_title or 'Commercial Bill'"/>
            <span> # </span><span t-out="doc.supply_ref or doc.name"/>
        </t>
        <t t-call="web.external_layout" address="address" layout_document_title="layout_document_title">
            <div class="page">
                <div class="oe_structure"/>
                <div class="row mb-4" name="bill_info">
                    <div class="col-auto"><strong>Reference:</strong> <span t-field="doc.name"/></div>
                    <div class="col-auto" t-if="doc.supply_ref"><strong>Supply Order No.:</strong> <span t-field="doc.supply_ref"/></div>
                    <div class="col-auto"><strong>Date:</strong> <span t-field="doc.date_order" t-options='{"widget": "date"}'/></div>
                    <div class="col-auto"><strong>Currency:</strong> <span t-field="doc.currency_id.name"/></div>
                </div>
                <t t-set="rows" t-value="doc._get_commercial_lines()"/>
                <t t-set="show_prices" t-value="company.commercial_bill_show_prices"/>
                <table class="table table-sm o_main_table table-borderless" name="bill_lines">
                    <thead style="display: table-row-group">
                        <tr>
                            <th class="text-start">#</th>
                            <th class="text-start">Description</th>
                            <th class="text-end">Quantity</th>
                            <th t-if="show_prices" class="text-end">Unit Price</th>
                            <th t-if="show_prices" class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="rows" t-as="row">
                            <tr>
                                <td class="text-start"><span t-out="row['no'] or row_index + 1"/></td>
                                <td class="text-start">
                                    <span t-out="row['name']"/>
                                    <div t-if="row['note'] and company.commercial_bill_show_notes" class="text-muted small">
                                        <span t-out="row['note']"/>
                                    </div>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-out="row['qty']" t-options='{"widget": "float", "decimal_precision": "Product Unit"}'/>
                                    <span t-out="row['uom']"/>
                                </td>
                                <td t-if="show_prices" class="text-end text-nowrap">
                                    <span t-out="row['price']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                                <td t-if="show_prices" class="text-end text-nowrap">
                                    <span t-out="row['amount']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <div t-if="show_prices" class="clearfix" name="bill_totals">
                    <div class="row justify-content-end">
                        <div class="col-6">
                            <table class="table table-sm table-borderless">
                                <tr class="border-top">
                                    <td><strong>Total</strong></td>
                                    <td class="text-end">
                                        <strong t-out="doc._commercial_total()"
                                                t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <p class="text-muted" t-out="doc.currency_id.amount_to_text(doc._commercial_total())"/>
                </div>
                <div t-if="company.commercial_bill_footer" class="mt-4" style="white-space: pre-line;">
                    <span t-out="company.commercial_bill_footer"/>
                </div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_commercial_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="invoice_customization.report_commercial_bill_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
