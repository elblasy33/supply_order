<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_invoice_group" model="ir.ui.view">
        <field name="name">account.move.form.invoice.group</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="supply_order.view_move_form_supply"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supply_ref']" position="after">
                <field name="group_invoice_lines" invisible="move_type == 'entry'"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not grouping_warning">
                    <field name="grouping_warning" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list" position="inside">
                <field name="invoice_group_name" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
