<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_invoice_customization" model="ir.ui.view">
        <field name="name">res.company.form.invoice.customization</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Invoice Customization" name="invoice_customization">
                    <group>
                        <group string="Invoices">
                            <field name="group_invoice_lines_default"/>
                        </group>
                        <group string="Commercial Bill">
                            <field name="commercial_bill_title"/>
                            <field name="commercial_bill_show_prices"/>
                            <field name="commercial_bill_show_notes"/>
                            <field name="commercial_bill_footer" placeholder="Bank details, origin, declaration…"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
